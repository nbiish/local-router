#!/usr/bin/env bash
# Resolve this script's real location first: setup links it into
# ~/.local/share/local-router/bin, and `$0` is the symlink, not the repo copy.
SOURCE="${BASH_SOURCE[0]}"
while [ -L "$SOURCE" ]; do
  DIR="$(cd -P "$(dirname "$SOURCE")" && pwd)"
  SOURCE="$(readlink "$SOURCE")"
  case "$SOURCE" in
    /*) ;;
    *) SOURCE="$DIR/$SOURCE" ;;
  esac
done
DIR="$(cd -P "$(dirname "$SOURCE")" && pwd)"
exec node "$DIR/lib/claude-runner.js" "$@"
