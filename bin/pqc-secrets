#!/usr/bin/env bash
# pqc-secrets — canonical platform-dispatch wrapper for the FIPS 203 secrets
# manager (ML-KEM-768 + AES-256-GCM). ainish-coder is the source of truth.
#
# Commands: keygen | gen | pack | export | verify | list | rename | migrate | setup | version | help
#
# Engines (2026-08-22):
#   python (canonical)  .agents/skills/pqc-secrets/scripts/pqc_secrets.py via
#                       `uv run` — native ML-KEM-768 seed-form. Covers ALL commands.
#   rust   (fast-path)  bin/pqc-secrets.darwin-arm64 — darwin/arm64 only, v1.2.0
#                       (2026-08-30) {keygen, pack, export, issue, envelope,
#                       vault}; seed-form ML-KEM-768 keychain stores (FIPS 203
#                       d‖z) fully supported, legacy expanded stores still read.
#                       list/rename/migrate/setup/version route to python;
#                       `./bin/pqc-secrets setup` installs uv when missing
#                       (pinned + sha256-verified).
#
# Platforms: architecture-agnostic. Runs in any POSIX shell — macOS Terminal,
#   any Linux shell, or the Ubuntu/WSL terminal on Windows. The canonical
#   engine is cross-platform Python; the Rust binary is an optional darwin/arm64
#   fast-path only, never required.
#
# Keys never leave this machine: no push, sync, or transport command exists.
set -euo pipefail

SOURCE="${BASH_SOURCE[0]}"
while [ -L "$SOURCE" ]; do
  DIR="$(cd -P "$(dirname "$SOURCE")" && pwd)"
  SOURCE="$(readlink "$SOURCE")"
  [[ $SOURCE != /* ]] && SOURCE="$DIR/$SOURCE"
done
SELF_DIR="$(cd -P "$(dirname "$SOURCE")" && pwd)"

NATIVE_BIN="$SELF_DIR/pqc-secrets.darwin-arm64"
PY_ENGINE="$SELF_DIR/../.agents/skills/pqc-secrets/scripts/pqc_secrets.py"

# Pinned, checksum-verified dependency for the setup command (2026-08-22).
# Never curl-to-bash: download the exact release tarball, verify sha256.
UV_PIN_VERSION="0.12.5"
UV_PIN_SHA256_X86_64="68a509da24b06b4223a1c0175fb5eb5bc79342b76cbeff0cfe51ac3f5b17b6b2"
UV_PIN_SHA256_AARCH64="9bf43b4d1a07665bf64d4c4e710930b382321a785e0eb10aac07f46471f86a31"

usage() {
  cat >&2 <<'EOF'
Usage: pqc-secrets <command> [args]

  keygen     Generate ML-KEM-768 keypair (private -> keychain/file, public -> recipient.pub)
  pack       Encrypt KEY=VALUE lines from stdin into the bundle
  gen        Generate high-entropy secret from OS CSPRNG (see: pqc-secrets gen --help)
  verify     Verify bundle decrypts; list key names only
  list       List every secret name (never values) — audit what is set
  rename     Rename one secret name: pqc-secrets rename <OLD_NAME> <NEW_NAME>
  migrate    Migrate keychain entry between account names
  setup      Fresh-machine bootstrap: pinned sha256-verified uv install + keygen
  version    Print engine identity, build date, crypto suite, command coverage
  vault      v1.2.0 identity root: init|migrate|unlock|lock|status|export-identity|sign|verify|audit-verify
  issue      v1.2.0 device-key issuance (vault-first, signed bundle): pqc-secrets issue <template> <name>
  envelope   v1.2.0 signed cross-machine transfer: pqc-secrets envelope export|import
  bootstrap  After one-time setup (VAULT_PASSPHRASE mirror in the bundle),
             vault-gated commands auto-unlock via the OS keychain — no
             passphrase prompts. PQC_UNLOCK_TTL overrides the 8h session TTL.

Naming:  Always prefix keys with the consuming tool's name —
           LOCALROUTER_*_API_KEY, AINISHCODER_*_API_KEY, ...
         Plain names are reserved for genuinely machine-shared keys.
         Audit which tool owns which key: pqc-secrets list

Bundle:  ~/.config/pqc-secrets/secrets.bundle.json
Keypair: ML-KEM-768 (FIPS 203). Payload: AES-256-GCM.
Keys never leave this machine (no push/sync/transport commands exist).
EOF
}

die_missing() {
  echo "pqc-secrets: $1" >&2
  exit 2
}

find_uv() {
  local bin
  bin="$(command -v uv 2>/dev/null || true)"
  if [ -z "$bin" ] && [ -x "$HOME/.local/bin/uv" ]; then
    bin="$HOME/.local/bin/uv"
  fi
  printf '%s' "$bin"
}

uv_missing_help() {
  cat >&2 <<'EOF'
pqc-secrets: 'uv' is required but not installed.

  Fastest fix (pinned, sha256-verified — no curl-to-bash):
    ./bin/pqc-secrets setup

  Or install manually:
    curl -LsSf https://astral.sh/uv/install.sh | bash
    # then either restart your shell or: export PATH="$HOME/.local/bin:$PATH"

  Verify the PQC tooling works:
    ./bin/pqc-secrets list
EOF
  exit 127
}

run_python() {
  local UV_BIN
  UV_BIN="$(find_uv)"
  [ -n "$UV_BIN" ] || uv_missing_help
  [ -f "$PY_ENGINE" ] || die_missing "Python engine not found at $PY_ENGINE"
  if [ "$(uname -s)" = "Darwin" ]; then
    # Keychain-first on macOS (matches the Rust engine's store); the Python
    # engine falls back to the encrypted file store when no entry exists.
    export PQC_USE_KEYCHAIN="${PQC_USE_KEYCHAIN:-true}"
  fi
  exec "$UV_BIN" run --script "$PY_ENGINE" "$@"
}

native_available() {
  [ "$(uname -s)" = "Darwin" ] && [ "$(uname -m)" = "arm64" ] && [ -x "$NATIVE_BIN" ]
}

run_setup() {
  set -u
  ARCH="$(uname -m)"
  case "$ARCH" in
    x86_64)  UV_ASSET="uv-x86_64-unknown-linux-gnu";  UV_SHA="$UV_PIN_SHA256_X86_64" ;;
    aarch64|arm64) UV_ASSET="uv-aarch64-unknown-linux-gnu"; UV_SHA="$UV_PIN_SHA256_AARCH64" ;;
    *) echo "pqc-secrets setup: unsupported architecture '$ARCH' (pin covers linux x86_64/aarch64)." >&2; exit 1 ;;
  esac

  local UV_BIN
  UV_BIN="$(find_uv)"
  if [ -n "$UV_BIN" ]; then
    echo "[setup] uv already installed: $("$UV_BIN" --version)"
  else
    echo "[setup] installing uv $UV_PIN_VERSION ($ARCH) with sha256 verification…"
    TMP_DIR="$(mktemp -d)/"
    trap 'rm -rf "$TMP_DIR"' EXIT
    TARBALL="$TMP_DIR$UV_ASSET.tar.gz"
    curl -fsSL --proto '=https' --tlsv1.2 -o "$TARBALL" \
      "https://github.com/astral-sh/uv/releases/download/$UV_PIN_VERSION/$UV_ASSET.tar.gz"
    echo "$UV_SHA  $TARBALL" | sha256sum -c - || { echo 'pqc-secrets setup: checksum mismatch — aborted.' >&2; exit 1; }
    mkdir -p "$HOME/.local/bin"
    tar -xzf "$TARBALL" -C "$TMP_DIR"
    install -m 0755 "$TMP_DIR$UV_ASSET/uv" "$HOME/.local/bin/uv"
    [ -f "$TMP_DIR$UV_ASSET/uvx" ] && install -m 0755 "$TMP_DIR$UV_ASSET/uvx" "$HOME/.local/bin/uvx" || true
    rm -rf "$TMP_DIR"; trap - EXIT
    UV_BIN="$HOME/.local/bin/uv"
    echo "[setup] installed: $("$UV_BIN" --version) -> $HOME/.local/bin"
    case ":$PATH:" in *":$HOME/.local/bin:"*) ;; *) echo "[setup] add to PATH: export PATH=\"\$HOME/.local/bin:\$PATH\"" ;; esac
  fi

  local CONFIG_DIR="${PQC_CONFIG_DIR:-$HOME/.config/pqc-secrets}"
  if [ -f "$CONFIG_DIR/recipient.pub" ] && [ -f "$CONFIG_DIR/private.key.enc" ]; then
    echo "[setup] keypair already present ($CONFIG_DIR)"
  else
    "$UV_BIN" run --script "$PY_ENGINE" keygen
  fi

  cat <<EOF
[setup] ready. Next:
  Pack keys under the consuming tool's namespace (see 'Naming' in help):
    printf 'LOCALROUTER_KILO_API_KEY=...\n' | ./bin/pqc-secrets pack
  Inspect what is set (names only, values never shown):
    ./bin/pqc-secrets list
  Rename an existing name (value kept, bundle backed up):
    ./bin/pqc-secrets rename OLD_NAME NEW_NAME

  Invariant: keys never leave this machine. No push, no sync, no transport
  command exists anywhere in this tooling — the bundle is encrypted with
  this machine's own ML-KEM-768 keypair and stays right here.
EOF
}

# ── Prompt-free bootstrap (2026-08-30) ────────────────────────────────────────
# One-time-setup contract: vault init + `pack` store a VAULT_PASSPHRASE entry
# in the bundle (see SKILL.md §5.12). After that, vault-gated commands never
# prompt: when the vault is locked and no PQC_VAULT_PASSPHRASE is set, the
# wrapper decaps the bundle via the OS keychain (same ML-KEM identity seed),
# reads the passphrase from the decrypted payload, and either unlocks the
# in-memory session holder (Rust surfaces — shared across all tooling) or
# injects PQC_VAULT_PASSPHRASE for the process (Python identity reads, which
# do not consult the holder). Any failure falls through to the engine's own
# session → env → prompt resolution, so bootstrap can only add convenience,
# never remove security. Override the session TTL with PQC_UNLOCK_TTL (8h).
#   $1: mode — "session" (Rust surfaces) | "env" (Python identity reads)
#   $@: mode=session only: export's post-command args, so a custom bundle
#       positional is decapped instead of the default.
pqc_bootstrap() {
  native_available || return 0
  [ -n "${PQC_VAULT_PASSPHRASE:-}" ] && return 0
  local mode="$1"
  shift
  local vault_path="${PQC_CONFIG_DIR:-$HOME/.config/pqc-secrets}/vault.pqc"
  [ -f "$vault_path" ] || return 0
  if [ "$mode" = session ]; then
    # Session live → the holder will serve the unwrap; nothing to bootstrap.
    # (mode=env must NOT skip: Python reads never consult the holder.)
    "$NATIVE_BIN" vault status 2>/dev/null | grep -q 'session: unlocked' && return 0
  fi

  # Decap the bundle via the OS keychain (never prompts). A custom export
  # positional targets that bundle; every other surface reads the default.
  local decap_args=("$NATIVE_BIN" export --use-keychain)
  if [ "$mode" = session ] && [ $# -gt 0 ]; then
    case "$1" in --*) ;; *) decap_args+=("$1") ;; esac
  fi
  local decap
  decap="$("${decap_args[@]}" 2>/dev/null)" || return 0
  local line val
  line="$(printf '%s\n' "$decap" | grep -m1 '^export VAULT_PASSPHRASE=')" || return 0
  val="$(eval "$(printf '%s' "$line")" 2>/dev/null; printf '%s' "${VAULT_PASSPHRASE:-}")"
  [ -n "$val" ] || return 0

  case "$mode" in
    env)     # Python identity reads don't consult the session holder.
      export PQC_VAULT_PASSPHRASE="$val"
      ;;
    session) # Unlock the shared in-memory holder for this and later calls.
      PQC_VAULT_PASSPHRASE="$val" "$NATIVE_BIN" vault unlock \
        --ttl "${PQC_UNLOCK_TTL:-8h}" >/dev/null 2>&1 || return 0
      ;;
  esac
  return 0
}

cmd="${1:-}"
case "$cmd" in
  keygen|pack|export)
    if native_available; then
      if [ "$cmd" = "export" ]; then
        case " $* " in *" --use-keychain"*) ;; *) pqc_bootstrap session "${@:2}" ;; esac
      fi
      exec "$NATIVE_BIN" "$@"
    fi
    run_python "$@"
    ;;
  vault|issue|envelope)
    # v1.2.0 Rust-only commands (vault identity root, device-key
    # issuance, signed cross-machine envelopes). The canonical Python
    # engine has no vault parity for these (read-side only), so fail
    # closed with a clear message when the native binary is absent.
    if native_available; then
      case "$cmd" in
        issue|envelope) pqc_bootstrap session ;;
        vault) case "${2:-}" in sign|export-identity|migrate) pqc_bootstrap session ;; esac ;;
      esac
      exec "$NATIVE_BIN" "$@"
    fi
    echo "pqc-secrets: '$cmd' requires the v1.2.0 Rust binary (darwin/arm64 fast-path)." >&2
    exit 2
    ;;
  list|rename|verify|migrate|version|gen)
    case "$cmd" in
      list|verify|rename) pqc_bootstrap env ;;
    esac
    run_python "$@"
    ;;
  setup|install)
    run_setup
    exit 0
    ;;
  -h|--help|help)
    usage
    exit 0
    ;;
  "")
    usage
    exit 3
    ;;
  *)
    echo "pqc-secrets: unknown command: $cmd" >&2
    usage
    exit 3
    ;;
esac
