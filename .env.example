PORT=11434
GROQ_API_KEY="your_groq_api_key_here"
OPENROUTER_API_KEY="your_openrouter_api_key_here"

# HTTPS listener for strict tooling that blocks http/localhost/127.0.0.1 URLs
# (transport-only TLS; generate material with `local-router tls setup`).
# LOCAL_ROUTER_TLS=true
# LOCAL_ROUTER_TLS_PORT=11443
# LOCAL_ROUTER_TLS_HOSTNAME=local-router.local
# LOCAL_ROUTER_TLS_CERT=/path/to/cert.pem
# LOCAL_ROUTER_TLS_KEY=/path/to/key.pem