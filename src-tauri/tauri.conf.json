{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Local Router",
  "version": "1.0.0",
  "identifier": "com.nbiish.localrouter",
  "build": {
    "frontendDist": "../build",
    "devUrl": "http://127.0.0.1:11434/config",
    "beforeDevCommand": "npm run dev:once",
    "beforeBuildCommand": "npm run build"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "title": "Local Router — Configuration",
        "label": "main",
        "url": "http://127.0.0.1:11434/config",
        "width": 1100,
        "height": 780,
        "resizable": true,
        "visible": false,
        "fullscreen": false
      }
    ],
    "trayIcon": {
      "iconPath": "icons/icon.png",
      "iconAsTemplate": true,
      "tooltip": "Local Router (127.0.0.1:11434)"
    },
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "category": "DeveloperTool",
    "shortDescription": "Local Ollama & OpenAI compatible proxy router with post-quantum secrets",
    "longDescription": "Local Router connects any Ollama or OpenAI compatible client to 19 AI providers with local fallback chains, parameter-level routing, and native corner system tray controls."
  },
  "plugins": {
    "autostart": {
      "macAllowed": true
    }
  }
}