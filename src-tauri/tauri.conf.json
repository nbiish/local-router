{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Local Router",
  "version": "1.1.0",
  "identifier": "com.nbiish.localrouter",
  "build": {
    "frontendDist": "../build",
    "devUrl": "http://127.0.0.1:11434/config",
    "beforeDevCommand": "npm run dev:once",
    "beforeBuildCommand": "npm run build"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "title": "Local Router — AI Model Gateway",
        "label": "main",
        "url": "http://127.0.0.1:11434/config",
        "width": 1200,
        "height": 820,
        "minWidth": 900,
        "minHeight": 600,
        "center": true,
        "resizable": true,
        "visible": true,
        "fullscreen": false
      }
    ],
    "trayIcon": {
      "iconPath": "icons/icon.png",
      "iconAsTemplate": true,
      "tooltip": "Local Router (127.0.0.1:11434)"
    },
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "category": "DeveloperTool",
    "shortDescription": "Local Ollama & OpenAI compatible model gateway and configuration UI",
    "longDescription": "Local Router is a standalone desktop application and local proxy gateway for 19 AI providers with explicit fallback chains, model curation, and post-quantum secrets protection."
  },
  "plugins": {
    "autostart": {
      "macAllowed": true
    }
  }
}