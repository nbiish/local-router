{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Local Router",
  "version": "1.2.2",
  "identifier": "com.nbiish.localrouter",
  "build": {
    "frontendDist": "../build",
    "devUrl": "http://127.0.0.1:11434/config",
    "beforeDevCommand": "npm run dev:once",
    "beforeBuildCommand": "npm run build"
  },
  "app": {
    "withGlobalTauri": true,
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "createUpdaterArtifacts": true,
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "category": "DeveloperTool",
    "shortDescription": "Local Ollama & OpenAI compatible model gateway and configuration UI",
    "longDescription": "Local Router is a standalone desktop application and local proxy gateway for 23 AI providers with explicit fallback chains, model curation, and post-quantum secrets protection."
  },
  "plugins": {
    "updater": {
      "endpoints": [
        "https://local-router.com/updates/latest.json"
      ],
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IDg4RDUwNEUwQUIzMkMzNQpSV1ExTExNS1RsQ05DT1RNQThnR1FGaWhmL0hQb1E1aWJIdWJIeTdacEFDNFlwcTI5U1dWWk91bAo="
    }
  }
}