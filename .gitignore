# AINISH Coder Tooling Distribution - Git Ignore Patterns
# PlatformIO ignore patterns

# PlatformIO ignore patterns
.pio*
.pio/
*.pioenvs/
pio.ini

# Environment and configuration files
.env
.env.*
!.env.example
*.env.local
*.env.development
*.env.test
*.env.production

# Virtual environments
venv/
venv.bak/
venv.bak*
venv.*
.venv/
ENV/
env/
.conda/
.python-version
*/.env
*/*env.*
!*env.example

# IDE and editor files
.vscode/
*.sublime-project
*.sublime-workspace

# OS generated files
.DS_Store
.DS_Store?

# Security and secrets
*.key
*.pem
*.p12
*.pfx
*.crt
*.csr
*.pem
*.p12
*.pfx
*.jks
*.keystore
secrets/
.secrets

# Database files
*.db
*.sqlite
*.sqlite3
*.db-journal

# Backup files
*.bak
*.backup
*.backup.*
*.old
*.orig
*.rej
*.orig
*.swp
*.swo

# Rust
target/

# Python
__pycache__/
*.pyc
build/
dist/
*.egg-info/
.pytest_cache/

# Shared Libraries
*.so
*.dylib
*.dll

# General
*.log
*.tmp
*.new
tmp/

# Node.js
node_modules/
npm-debug.log
yarn-error.log
.pnpm-debug.log

# Security reports
SECURITY_REPORT.md

# Scrolls Lab runtime artifacts
scrolls-lab/logs/
scrolls-lab/reference/
scrolls-lab/omni_output/
scrolls-lab/sections/
scrolls-lab/working/
scrolls-lab/original/
scrolls-lab/output/
*.patch

# Omni Extractor media files (global safety)
**/*.jpg
**/*.mp4
**/*.vtt
providers.txt
**/providers.txt
providers**.txt
**/providers**.txt

# Scrolls ceremony cloned repos (large)
.scrolls-ceremony/repos/

# Graphify scratch output
graphify-out/

# Local graph/editor artifacts — accident guards only; no doctrine depends on
# them (llms.txt "Graph & Memory Tooling Stance")
.gitnexus/
.claude/
.agents/skills/gitnexus-*/

# PQC secrets — bundle and audit log (the .env patterns above cover
# most cases, but PQC artifacts are explicit for clarity)
secrets.bundle.json
secrets.bundle.json.bak.*
audit.log
audit.log.*
# Local pqc-sign public keys (used for verification, not for committing)
.pqc-keys/*.priv
.pqc-keys/*.sk
.agents/audit/*.priv
.agents/audit/*.sk
.agents/audit/keys/*.priv
.agents/audit/keys/*.sk
**/*.priv
**/*.sk

# Hermes / agent plan and context directories (auto-injected by
# subdirectory context discovery — never intended for git)
.hermes/
.omx/
.omo/
.omp/

# Agent COMMS live board — in-flight coordination, never committed.
# The daily team ledger .agents/comms/{date}-team.txt IS committed; this sidecar is not.
.agents/comms/*-team.live.txt

# Multimodal RAG local vector store and runtime process PID.
# Ignored as directory *contents* rather than as a directory, so the benchmark baseline below can
# be re-included: git never descends into an ignored directory, so a `!.agents/rag/x` exception is
# inert while `.agents/rag/` itself is ignored.
.agents/rag/*
# ...except the benchmark baseline, which is the committed floor every retrieval change is
# measured against (Phase 0 of docs/rag-context-system-plan.md). It holds no secrets or vectors.
!.agents/rag/bench-baseline.json

# Rules auto-sync runtime artifacts (manifest and sync script ARE committed)
.agents/ainish-sync.log
.agents/.rules-sync.lock/

# Compiled native binaries (built locally via cargo or distributed wrappers)
*.exe

# Deployment smoke sandbox (created by 'ainish-coder --rules test'); never tracked.
/test/

# ═══════════════════════════════════════════════════════════════════════════
# Project-specific patterns (preserved from existing .gitignore)
# ═══════════════════════════════════════════════════════════════════════════

.agents/rag/
.config/
.opencode/
.workbuddy-ai/
example-repos/
node_modules
# Live chain config for the checkout it sits in (repo-local config, 2026-11-10).
# Written by the running router and carried to other machines by a repo sync, so it
# stays untracked: a chain save must never dirty the worktree or block a git pull.
router-settings.json
src-tauri/gen/
src-tauri/target/
src/**/*.d.ts
src/**/*.d.ts.map
src/**/*.js
src/**/*.js.map

