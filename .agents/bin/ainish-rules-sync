#!/bin/sh
# Managed by ainish-coder. Refreshes this repository's agent rules when the
# ainish-coder source contract advances. Safe no-op when already current.
set -u
ROOT=$(CDPATH= cd -- "$(dirname -- "$0")/../.." 2>/dev/null && pwd) || exit 0
MANIFEST="$ROOT/.agents/ainish-deploy.json"
LOG="$ROOT/.agents/ainish-sync.log"
QUIET=0
[ "${1:-}" = "--quiet" ] && QUIET=1
[ -f "$MANIFEST" ] || exit 0

field() {
    sed -n "s/^[[:space:]]*\"$1\":[[:space:]]*\"\([^\"]*\)\".*/\1/p" "$MANIFEST" 2>/dev/null | head -n 1
}

SRC=$(field source_repo)
DEPLOYED_COMMIT=$(field source_commit)
DEPLOYED_SHA=$(field source_agents_sha256)
DEPLOYED_PACK=$(field source_pack_sha256)
[ -n "$SRC" ] || exit 0

CUR_SHA=""
sha_of() {
    if command -v sha256sum >/dev/null 2>&1; then
        sha256sum "$1" 2>/dev/null | awk '{print $1}'
    elif command -v shasum >/dev/null 2>&1; then
        shasum -a 256 "$1" 2>/dev/null | awk '{print $1}'
    elif command -v openssl >/dev/null 2>&1; then
        openssl dgst -sha256 "$1" 2>/dev/null | awk '{print $NF}'
    fi
}

# Digest of a directory tree, mirroring the source's pack digest. Used so a skill-pack
# edit (not just an AGENTS.md edit) is still seen as a real change.
sha_dir() {
    [ -d "$1" ] || return 0
    local tmp
    tmp="$(mktemp "${TMPDIR:-/tmp}/ainish-pack.XXXXXX" 2>/dev/null)" || return 0
    (cd "$1" 2>/dev/null && find . -type f | LC_ALL=C sort | while IFS= read -r f; do
        printf '%s  %s\n' "$(sha_of "$f")" "$f"
    done) > "$tmp" 2>/dev/null
    sha_of "$tmp"
    rm -f "$tmp"
}

CURRENT_COMMIT=""
if command -v git >/dev/null 2>&1; then
    # git -C resolves both a normal checkout and a worktree (where .git is a file).
    CURRENT_COMMIT=$(git -C "$SRC" rev-parse HEAD 2>/dev/null || true)
fi

# Content, not commit SHA, decides staleness: a commit that did not change the deployed
# bytes must not redeploy and re-sign the whole fleet. Commit equality is only a fallback
# for manifests written before content hashes were recorded.
UP_TO_DATE=0
if [ -f "$SRC/AGENTS.md" ] && [ -n "$DEPLOYED_SHA" ]; then
    CUR_SHA=$(sha_of "$SRC/AGENTS.md")
    CUR_PACK=$(sha_dir "$SRC/skills-to-distribute/skills/pqc-secrets")
    if [ -n "$CUR_SHA" ] && [ "$CUR_SHA" = "$DEPLOYED_SHA" ] && \
       { [ -z "$DEPLOYED_PACK" ] || { [ -n "$CUR_PACK" ] && [ "$CUR_PACK" = "$DEPLOYED_PACK" ]; }; }; then
        UP_TO_DATE=1
    fi
elif [ -n "$CURRENT_COMMIT" ] && [ "$CURRENT_COMMIT" = "$DEPLOYED_COMMIT" ]; then
    UP_TO_DATE=1
fi
[ "$UP_TO_DATE" = "1" ] && exit 0

CLI="$SRC/bin/ainish-coder"
[ -x "$CLI" ] || CLI=$(command -v ainish-coder 2>/dev/null || true)
[ -n "$CLI" ] || exit 0

LOCK="$ROOT/.agents/.rules-sync.lock"
# Directory lock: mkdir is atomic. A run killed before its EXIT trap leaves the
# lock behind, so a lock older than 15 minutes is reclaimed once — otherwise one
# crash would disable auto-sync for this repository forever.
if ! mkdir "$LOCK" 2>/dev/null; then
    if [ -n "$(find "$LOCK" -maxdepth 0 -mmin +15 2>/dev/null)" ]; then
        rm -rf "$LOCK" 2>/dev/null || true
        mkdir "$LOCK" 2>/dev/null || exit 0
    else
        exit 0
    fi
fi
# rm -rf, not rmdir: macOS refuses rmdir on directories carrying the
# com.apple.provenance xattr (EPERM) even for the owner.
trap 'rm -rf "$LOCK" 2>/dev/null || true' EXIT INT TERM HUP

[ "$QUIET" = "1" ] || printf '[ainish-rules-sync] refreshing rules from %s\n' "$SRC"
# Exit non-zero on failure so `--rules-sync --all` can report a truthful fleet
# state; the git hooks that call this refresher already append `|| true`, so a
# failed refresh never blocks a commit or merge.
if AINISH_RULES_SYNC_ACTIVE=1 "$CLI" --rules "$ROOT" --headless -y >>"$LOG" 2>&1; then
    [ "$QUIET" = "1" ] || printf '[ainish-rules-sync] rules refreshed\n'
    exit 0
fi
printf '[ainish-rules-sync] refresh failed; see %s\n' "$LOG" >&2
exit 1
